# Ejemplo para Ubuntu/Debian en la VM.
# Copia a /etc/nginx/sites-available/tivotabo y enlaza en sites-enabled.
#
# Desarrollo (Vite 5173 + server 8787 en paralelo con npm run dev:all):
#   proxy_pass → http://127.0.0.1:5173
#
# Producción (recomendado para dominio público: npm run build && npm start):
#   proxy_pass → http://127.0.0.1:8787
#
# Tras editar: sudo nginx -t && sudo systemctl reload nginx
# DNS: registro A de tivotabo.com (y www si quieres) → 168.228.192.202
# Firewall: abrir 80 (y 443 si usas HTTPS). No hace falta exponer 5173 al mundo.

server {
    listen 80;
    listen [::]:80;
    server_name tivotabo.com www.tivotabo.com;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
