# Ejemplo para Ubuntu/Debian en la VM.
# Copia a /etc/nginx/sites-available/tivotabo y enlaza en sites-enabled.
#
# Desarrollo (Vite 5173 + server 8787 con npm run dev:all):
#   proxy_pass → http://127.0.0.1:5173  (Vite sirve / y /PrediccionesMundial/)
#
# Producción (npm run build && npm start en puerto 8787):
#   proxy_pass → http://127.0.0.1:8787
#
# URLs:
#   http://tivotabo.com/                      → landing (redes)
#   http://tivotabo.com/PrediccionesMundial/ → quiniela
#
# Tras editar: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name tivotabo.com www.tivotabo.com;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
